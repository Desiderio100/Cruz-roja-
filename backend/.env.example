# Copia este archivo como ".env" (cp .env.example .env) y llena TU usuario y TU contraseña.
# El archivo .env NUNCA se sube a GitHub (ya está en .gitignore).
DB_HOST=mysql-398be311-tec-3a79.d.aivencloud.com
DB_PORT=16982
# Tu usuario de desarrollo (dev_tunombre). En producción: cruzroja_app.
DB_USER=dev_tunombre
DB_PASSWORD=
DB_NAME=cruzroja
# Certificado de Aiven (lo bajas de la consola de Aiven, "CA certificate"). Ponlo en esta carpeta.
DB_CA_PATH=./ca.pem
PORT=3000

# ── SMS del registro (HU01) ──────────────────────────────────────────────────
# consola  = NO manda SMS; el código sale en la terminal de `npm run dev` (desarrollo).
# twilio   = manda SMS con Twilio (llena las TWILIO_* de abajo).
# mensajes = con la app Mensajes de esta Mac (solo macOS, sin comprobar).
SMS_MODO=twilio
# Solo desarrollo: si el SMS falla, el código sale en la terminal (se apaga con NODE_ENV=production).
SMS_RESPALDO_CONSOLA=no
# Lada que se agrega a los números de 10 dígitos (52 = México).
SMS_PAIS=52
# Twilio (https://console.twilio.com). Con TWILIO_VERIFY_SID se usa Twilio Verify.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
TWILIO_VERIFY_SID=

# ── Pagos con Stripe (Productos con causa) ───────────────────────────────────
# Todo en MODO PRUEBA: Stripe Dashboard > "Entorno de prueba" > Desarrolladores > Claves de API.
# La llave SECRETA (sk_test_...) solo va aquí. NUNCA en la app, en GitHub ni en un chat.
# Si dejas STRIPE_SECRET_KEY vacía, los pagos quedan apagados y lo demás funciona igual.
STRIPE_SECRET_KEY=
# Llave publicable (pk_test_...): es la única que el servidor le manda a la app.
STRIPE_PUBLISHABLE_KEY=
# Secreto del webhook (whsec_...). En tu Mac lo imprime `stripe listen --events ...` (comando completo en ../PAGOS_STRIPE.md, paso 4).
STRIPE_WEBHOOK_SECRET=
# Costo fijo del envío a domicilio, en pesos. Provisional: definir con Cruz Roja.
ENVIO_MXN=99

# ── Sitio de administración de pedidos (http://localhost:3000/admin/) ────────
# Secreto con el que se firman las sesiones del personal. MÍNIMO 32 caracteres.
# Genera uno:  node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Es secreto como las llaves de Stripe: NUNCA en GitHub ni en un chat. Si lo cambias, se cierran todas las sesiones.
# Si lo dejas VACÍO, el sitio de administración queda apagado y todo lo demás funciona igual.
# Las cuentas del personal se crean con `npm run crear:personal` (ver ../PAGOS_STRIPE.md, paso 8).
# En producción usa un valor NUEVO y NODE_ENV=production (la sesión exige HTTPS).
ADMIN_SESION_SECRETO=
# Opcional: dirección del panel de llamadas y citas (carpeta ../personal, `npm run dev` ahí, puerto 4000).
# Si la pones, la barra del sitio de pedidos muestra el enlace "Llamadas y citas". Vacío = sin enlace.
PANEL_PERSONAL_URL=http://localhost:4000/

# ── Llamada en vivo (audio y video con LiveKit) ──────────────────────────────
# LIVEKIT_URL es la dirección del proyecto en LiveKit Cloud (empieza con wss://).
# La clave y el secreto salen de LiveKit Cloud > Settings > API keys. Nunca se suben a GitHub.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
