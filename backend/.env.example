# Copia este archivo como ".env" (cp .env.example .env) y llena TU usuario y TU contraseña.
# El archivo .env NUNCA se sube a GitHub (ya está en .gitignore).
DB_HOST=mysql-398be311-tec-3a79.d.aivencloud.com
DB_PORT=16982
# Tu usuario de desarrollo (dev_tunombre). En producción: cruzroja_app.
DB_USER=dev_tunombre
DB_PASSWORD=
DB_NAME=cruzroja
# Certificado de Aiven (lo bajas de la consola de Aiven, "CA certificate"). Ponlo en esta carpeta.
DB_CA_PATH=./ca.pem
PORT=3000

# ── SMS del registro (HU01) ──────────────────────────────────────────────────
# consola  = NO manda SMS; el código sale en la terminal de `npm run dev` (desarrollo).
# twilio   = manda SMS con Twilio (llena las TWILIO_* de abajo).
# mensajes = con la app Mensajes de esta Mac (solo macOS, sin comprobar).
SMS_MODO=consola
# Solo desarrollo: si el SMS falla, el código sale en la terminal (se apaga con NODE_ENV=production).
SMS_RESPALDO_CONSOLA=si
# Lada que se agrega a los números de 10 dígitos (52 = México).
SMS_PAIS=52
# Twilio (https://console.twilio.com). Con TWILIO_VERIFY_SID se usa Twilio Verify.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
TWILIO_VERIFY_SID=
