{
  "name": "cruzroja-api",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "API única de la app Cruz Roja. Una carpeta de rutas por pantalla en src/rutas.",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --env-file=.env --watch src/server.js",
    "probar": "node scripts/probar.js",
    "probar:pagos": "node --env-file=.env.local --test test/pagos.test.js",
    "crear:personal": "node scripts/crear_personal.js",
    "probar:admin": "node --env-file=.env.local --test test/admin.test.js",
    "probar:cursos": "node --env-file=.env.local --test test/cursos.test.js",
    "probar:citas": "node --env-file=.env.local --test test/citas.test.js",
    "probar:llamadas": "node --env-file=.env.local --test test/llamadas.test.js",
    "probar:todo": "node --env-file=.env.local --test"
  },
  "engines": {
    "node": ">=20.6"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "mysql2": "^3.24.6",
    "stripe": "^23.0.1",
    "zod": "^3.24.2"
  }
}
