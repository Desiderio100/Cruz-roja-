# Copia este archivo como ".env.local" para correr las pruebas de pagos y de administración
# (npm run probar:pagos, probar:admin, probar:todo) contra un MySQL de TU compu.
# Las pruebas se niegan a correr contra otra base: crean y borran datos.
# Antes: en tu MySQL local corre db/01_esquema.sql, 02_datos_prueba.sql, 08_pedidos.sql, 09_pedidos_admin.sql y 10_modo_personal.sql.
# Las pruebas de administración dejan unas filas en `bitacora` y `personal` (cuentas prueba.*.pagos):
# es a propósito, la bitácora no se puede borrar.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
# La contraseña de TU MySQL local (no la de Aiven).
DB_PASSWORD=
DB_NAME=cruzroja
