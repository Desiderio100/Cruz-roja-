# Copia este archivo como ".env" (cp .env.example .env) y llena la contrasena de cruzroja_web.
# El archivo .env NUNCA se sube a GitHub (ya esta en .gitignore).
DB_HOST=mysql-398be311-tec-3a79.d.aivencloud.com
DB_PORT=16982
DB_USER=cruzroja_web
DB_PASSWORD=
DB_NAME=cruzroja
# Certificado de Aiven ("CA certificate" en la consola). Ponlo en esta carpeta.
DB_CA_PATH=./ca.pem
PORT=4000

# Texto largo y al azar que firma la cookie de sesion. Obligatorio con NODE_ENV=production.
# Ejemplo para generarlo: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESION_SECRETO=

# Detras de un proxy con HTTPS (Render, Nginx...) pon TRUST_PROXY=1 para ver la IP real y activar la cookie segura.
# TRUST_PROXY=1

ZONA_HORARIA=America/Mexico_City
MAXIMO_INTENTOS=5
BLOQUEO_MINUTOS=3
PERDIDAS_HORAS=24

# Llamada en vivo (audio y video con LiveKit). Los mismos tres valores que usa el backend de la app.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
