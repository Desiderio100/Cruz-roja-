IME(3)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="conectada_en">conectada_en</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">DATETIME(3)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="datos_recibidos_en">datos_recibidos_en</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">DATETIME(3)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="fin">fin</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">DATETIME(3)</FONT></TD></TR></TABLE>>];
