  subgraph "cluster_Productos con causa" {
    label="Productos con causa"; fontname="Helvetica-Bold"; fontsize=14; color="#00695C"; style="rounded";
    producto [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3"><TR><TD COLSPAN="2" BGCOLOR="#00695C"><FONT COLOR="white"><B>producto</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id">id <FONT COLOR="#00695C"><B>PK</B></FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#666666">INT</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="nombre">nombre</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">VARCHAR(150)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="precio_mxn">precio_mxn</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">DECIMAL(10,2)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="causa">causa</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">VARCHAR(200)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="imagen_url">imagen_url</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">VARCHAR(500)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="enlace_compra">enlace_compra</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">VARCHAR(500)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="activo">activo</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">TINYINT(1)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="actualizado_en">actualizado_en</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">DATETIME(3)</FONT></TD></TR></TABLE>>];
    pedido [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3"><TR><TD COLSPAN="2" BGCOLOR="#00695C"><FONT COLOR="white"><B>pedido</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id">id <FONT COLOR="#00695C"><B>PK</B></FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#666666">CHAR(36)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="folio">folio</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">VARCHAR(16)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="dispositivo_id">dispositivo_id <FONT COLOR="#00695C"><B>FK</B></FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#666666">CHAR(36)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="producto_id">producto_id <FONT COLOR="#00695C"><B>FK</B></FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#666666">INT</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="producto_nombre">producto_nombre</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">VARCHAR(150)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="cantidad">cantidad</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">SMALLINT</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="precio_unitario_mxn">precio_unitario_mxn</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">DECIMAL(10,2)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="envio_mxn">envio_mxn</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">DECIMAL(10,2)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="total_mxn">total_mxn</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">DECIMAL(10,2)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="estado">estado</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">ENUM</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="stripe_payment_intent_id">stripe_payment_intent_id</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">VARCHAR(100)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="nombre">nombre</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">VARCHAR(120)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="telefono">telefono</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">VARCHAR(16)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="calle_numero">calle_numero</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">VARCHAR(150)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="colonia">colonia</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">VARCHAR(100)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="ciudad">ciudad</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">VARCHAR(100)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="entidad">entidad</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">VARCHAR(60)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="codigo_postal">codigo_postal</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">CHAR(5)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="referencias">referencias</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">VARCHAR(200)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="creado_en">creado_en</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">DATETIME(3)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="pagado_en">pagado_en</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">DATETIME(3)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="estado_envio">estado_envio</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">ENUM</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="guia_envio">guia_envio</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">VARCHAR(40)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="enviado_en">enviado_en</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">DATETIME(3)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="entregado_en">entregado_en</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">DATETIME(3)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="stripe_refund_id">stripe_refund_id</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">VARCHAR(100)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="reembolsado_en">reembolsado_en</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">DATETIME(3)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="reembolso_motivo">reembolso_motivo</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">VARCHAR(200)</FONT></TD></TR></TABLE>>];
    pedido_folio_seq [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3"><TR><TD COLSPAN="2" BGCOLOR="#00695C"><FONT COLOR="white"><B>pedido_folio_seq</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id">id <FONT COLOR="#00695C"><B>PK</B></FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#666666">BIGINT</FONT></TD></TR></TABLE>>];
    evento_stripe [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3"><TR><TD COLSPAN="2" BGCOLOR="#00695C"><FONT COLOR="white"><B>evento_stripe</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id">id <FONT COLOR="#00695C"><B>PK</B></FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#666666">VARCHAR(100)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="tipo">tipo</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">VARCHAR(80)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="recibido_en">recibido_en</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">DATETIME(3)</FONT></TD></TR></TABLE>>];
  }
  personal:delegacion_id -> delegacion;
  consentimiento:dispositivo_id -> dispositivo;
  consentimiento:version_aviso -> aviso_privacidad;
  llamada:delegacion_id -> delegacion;
  llamada:operador_id -> personal;
  llamada:dispositivo_id -> dispositivo;
  ficha:llamada_id -> llamada;
  ficha:editado_por -> personal;
  especialista:delegacion_id -> delegacion;
  cita:especialista_id -> especialista;
  cita:dispositivo_id -> dispositivo;
  curso:delegacion_id -> delegacion;
  inscripcion_curso:curso_id -> curso;
  inscripcion_curso:dispositivo_id -> dispositivo;
  bitacora:personal_id -> personal;
  pedido:dispositivo_id -> dispositivo;
  pedido:producto_id -> producto;
  transcripcion:llamada_id -> llamada;
}
